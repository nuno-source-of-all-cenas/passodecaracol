    "\\bwear ?os\\b",
    "\\bcoros\\b",
    "\\bwahoo\\b",
    "\\bsync",
    "\\bupload(ed|ing)? (fail|error|issue)"
   ]
  },
  {
   "id": "flagged",
   "label": "Flagged activities and leaderboard cheating",
   "kind": "complaint",
   "patterns": [
    "\\bflag(ged|ging)?\\b",
    "\\bcheat",
    "\\be-?bike",
    "\\bin a car\\b",
    "\\bleaderboard",
    "\\bkom\\b",
    "\\bqom\\b"
   ]
  },
  {
   "id": "segments_paywall",
   "label": "Segments and analysis moved behind the paywall",
   "kind": "complaint",
   "patterns": [
