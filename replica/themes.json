    "\\bpermissions for\\b"
   ]
  },
  {
   "id": "gps",
   "label": "GPS accuracy and lost recordings",
   "kind": "complaint",
   "patterns": [
    "\\bgps\\b",
    "\\blost (my|the) (run|ride|activity|recording)",
